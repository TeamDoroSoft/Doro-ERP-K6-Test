# 복사해서 .env 로 쓰거나, export 해서 사용하세요.
# .env 는 커밋되지 않습니다.

BASE_URL=https://edge.dev.example.com
RUN_ID=LOADTEST-001

TENANT_CODE=loadtest001
OWNER_ID=owner01
OWNER_PW=변경하세요
STAFF_PW=변경하세요
KIOSK_SECRET=변경하세요
# 등록된 device001... 순서의 raw secret 또는 kdc_<id>.<secret> 값을 쉼표로 입력
KIOSK_SECRETS=

# 부하 기준값 (팀 협의 목표치)
VU_NORMAL=10
VU_PEAK=50
VU_LIMIT=100

# 매장 주문 비율. 0 = 전부 포장 (기본값, README 참고)
DINE_IN_RATIO=0
